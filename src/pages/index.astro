---
import Layout from '../layouts/Layout.astro';
import TerminalWindow from '../components/TerminalWindow.astro';
import CLI from '../components/CLI.astro';
import GUIView from '../components/GUIView.astro';
import { getCollection } from 'astro:content';
const projects = (await getCollection('projects', ({ data }) => !data.draft && data.featured))
  .sort((a, b) => a.data.order - b.data.order);
---
<Layout title="Benjamin Sauer // Engineering Portfolio">
  <TerminalWindow home>
    <GUIView projects={projects} />
    <CLI projects={projects} />
  </TerminalWindow>
</Layout>
