---
import type { CollectionEntry } from "astro:content";
import type { MarkdownHeading } from "astro";
import Layout from "./Layout.astro";
import TerminalWindow from "../components/TerminalWindow.astro";
import ProjectMedia from "../components/ProjectMedia.astro";
import { sitePath } from "../utils/paths";
interface Props { project: CollectionEntry<"projects">; headings: MarkdownHeading[]; next?: CollectionEntry<"projects">; }
const { project, headings, next } = Astro.props;
const { data } = project;
---
<Layout title={`${data.title} // Benjamin Sauer`} description={data.summary}>
  <TerminalWindow>
    <article class="project-detail">
      <a class="back-link" href={sitePath("#projects")}>← All projects</a>
      <header class="project-heading">
        <p class="eyebrow">{data.discipline} / {data.period}</p>
        <h1>{data.title}</h1>
        <p class="project-deck">{data.summary}</p>
        <dl class="project-meta"><div><dt>MY ROLE</dt><dd>{data.role}</dd></div><div><dt>TOOLS & METHODS</dt><dd>{data.tools.join(" · ")}</dd></div></dl>
      </header>
      <img class:list={["project-cover", { "contain-image": data.coverFit === "contain" }]} src={sitePath(data.cover)} alt={data.coverAlt} width="1200" height="800" fetchpriority="high" />
      <div class="project-body-grid">
        <aside class="project-toc" aria-label="On this page"><p class="eyebrow">In this project</p><nav>{headings.filter(heading => heading.depth === 2).map(heading => <a href={`#${heading.slug}`}>{heading.text}</a>)}{data.media.length > 0 && <a href="#project-gallery">Project gallery</a>}{data.downloads.length > 0 && <a href="#project-resources">Resources</a>}</nav></aside>
        <div>
          <div class="project-prose"><slot /></div>
          {data.media.length > 0 && <section id="project-gallery" class="project-gallery"><p class="eyebrow">Documentation</p><h2>Project gallery</h2>{data.media.map(media => <ProjectMedia {...media} />)}</section>}
          {data.downloads.length > 0 && <section id="project-resources" class="project-resources"><h2>Resources</h2><ul>{data.downloads.map(file => <li><a href={sitePath(file.href)}>{file.label} <span aria-hidden="true">↗</span></a></li>)}</ul></section>}
        </div>
      </div>
      <nav class="project-next" aria-label="More projects"><a href={sitePath("#projects")}>← All projects</a>{next && <a href={sitePath(`projects/${next.id}/`)}>Next: {next.data.title} →</a>}</nav>
    </article>
  </TerminalWindow>
</Layout>
