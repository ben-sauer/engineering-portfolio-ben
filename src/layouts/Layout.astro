---
import "../styles/global.css";
import { PORTFOLIO_DATA } from "../data/portfolio";
import { sitePath } from "../utils/paths";
interface Props { title?: string; description?: string; }
const { title = `${PORTFOLIO_DATA.developer.name} // Engineering Portfolio`, description = PORTFOLIO_DATA.developer.bio } = Astro.props;
---
<!DOCTYPE html>
<html lang="en" data-theme="green">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#0a120b" />
    <link rel="icon" type="image/svg+xml" href={sitePath("favicon.svg")} />
    <title>{title}</title>
    <script>
      import { applyTheme } from "../config/themeConfig";
      let theme = "green";
      try { theme = localStorage.getItem("tui_theme") || theme; } catch { /* Storage is optional. */ }
      applyTheme(theme);
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div id="crt-overlay-layer" class="crt-overlay hidden" aria-hidden="true"></div>
    <div class="site-wrap"><slot /></div>
  </body>
</html>
