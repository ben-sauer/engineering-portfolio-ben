---
import type { CollectionEntry } from "astro:content";
import { PORTFOLIO_DATA } from "../data/portfolio";
import { sitePath } from "../utils/paths";
import Neofetch from "./Neofetch.astro";
import ProjectCard from "./ProjectCard.astro";
import SectionHeading from "./SectionHeading.astro";
interface Props { projects: CollectionEntry<"projects">[]; }
const { projects } = Astro.props;
const { developer, skills, leadership, experience } = PORTFOLIO_DATA;
---
<div id="view-gui">
  <section class="profile-panel" aria-labelledby="intro-title">
    <div class="profile-bar"><span><span aria-hidden="true">&gt;_</span> ~/portfolio / profile</span><span class="profile-stamp">ENGINEERING STUDENT</span></div>
    <div class="hero">
      <div class="hero-copy">
        <p class="eyebrow"><span aria-hidden="true">$</span> home_page</p>
        <h1 id="intro-title">BENJAMIN<br /><span>SAUER</span></h1>
        <p class="hero-focus">Dynamics · Controls · Mechanical Design</p>
        <Neofetch />
        <div class="bio-block"><p class="bio-label"><span aria-hidden="true">&gt;</span> cat bio.txt</p><p class="hero-description">{developer.bio}</p></div>
        <div class="button-row">
          <a class="button primary" href="#projects">[ Explore projects ↓ ]</a>
          <a class="button" href={sitePath(developer.resume)}>[ Resume ]</a>
        </div>
      </div>
      <figure class="hero-photo">
        <div class="photo-bar"><span aria-hidden="true">▧</span> benjamin-sauer.webp</div>
        <img src={sitePath("images/benjamin-sauer.webp")} alt="Benjamin Sauer speaking at an event" width="1200" height="800" fetchpriority="high" />
        <figcaption>{developer.name}<span>Harvey Mudd College · Class of 2028</span></figcaption>
      </figure>
    </div>
  </section>

  <section id="projects" class="portfolio-section" aria-labelledby="projects-title">
    <SectionHeading id="projects-title" command="ls projects/" title="Selected engineering work" />
    <div class="project-grid">{projects.map((project, index) => <ProjectCard project={project} index={index} />)}</div>
  </section>

  <section id="skills" class="portfolio-section panel-section" aria-labelledby="skills-title">
    <SectionHeading id="skills-title" command="./skills.sh" title="Technical toolkit"/>
    <div class="skills-grid">{skills.map((group, index) => <div class="skill-group">
      <h3><span class="skill-index" aria-hidden="true">[{String(index + 1).padStart(2, "0")}]</span>{group.category}</h3>
      <ul>{group.items.map(item => <li><span aria-hidden="true">▸</span>{item}</li>)}</ul>
    </div>)}</div>
  </section>

  <section id="leadership" class="portfolio-section panel-section" aria-labelledby="leadership-title">
    <SectionHeading id="leadership-title" command="leadership.md" title="Leadership & Outreach" />
    <div class="leadership-body">
      <div class="leadership-title"><p class="eyebrow">STEM BRIDGES</p><h3>{leadership.title}</h3><p class="muted">{leadership.period}</p><p class="status-note">{leadership.status}</p></div>
      <div class="leadership-copy"><p>{leadership.description}</p><p>{leadership.details}</p></div>
    </div>
  </section>

  <section id="experience" class="portfolio-section panel-section" aria-labelledby="experience-title">
    <SectionHeading id="experience-title" command="experience.md" title="Experience & involvement" />
    <div class="experience-list">{experience.map((item, index) => <article class="experience-card">
      <div class="entry-heading"><h3><span class="entry-marker" aria-hidden="true">[{String(index + 1).padStart(2, "0")}]</span>{item.title}</h3><span class="entry-period">{item.period}</span></div>
      <p class="experience-org"><span>Organization:</span> {item.organization}</p>
      <p class="experience-description">{item.description}</p>
    </article>)}</div>
  </section>

  <section id="contact" class="portfolio-section panel-section" aria-labelledby="contact-title">
    <SectionHeading id="contact-title" command="contact.txt" title="Let’s connect" badge="CONTACT" />
    <div class="contact-section">
      <p>I’m interested in internship and entry-level opportunities in engineering.</p>
      <div class="contact-links"><a class="contact-email" href={`mailto:${developer.email}`}>{developer.email} <span aria-hidden="true">↗</span></a><a href={sitePath(developer.resume)}>[ Download resume (PDF) ↓ ]</a></div>
    </div>
  </section>
</div>
