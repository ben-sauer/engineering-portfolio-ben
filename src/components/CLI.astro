---
import type { CollectionEntry } from "astro:content";
import { PORTFOLIO_DATA } from "../data/portfolio";
import { sitePath } from "../utils/paths";
interface Props { projects: CollectionEntry<"projects">[]; }
const { projects } = Astro.props;
const { developer, skills } = PORTFOLIO_DATA;
const entries = projects.map(project => ({ title: project.data.title, summary: project.data.summary, href: sitePath(`projects/${project.id}/`) }));
---
<section id="view-cli" class="cli-view" aria-label="Optional portfolio terminal" hidden>
  <p class="eyebrow">ben@engineering:~/portfolio</p>
  <h1 class="cli-heading">Engineering, from the command line.</h1>
  <p>This terminal is an alternate way to explore the portfolio. Type <code>help</code> to get started.</p>
  <div id="cli-output" class="cli-output" role="log" aria-live="polite" aria-relevant="additions"></div>
  <form id="cli-form" autocomplete="off">
    <label for="cli-input"><span aria-hidden="true">❯</span><span class="sr-only">Portfolio command</span></label>
    <input id="cli-input" name="command" type="text" spellcheck="false" autocapitalize="off" aria-describedby="cli-hint" />
    <button class="button" type="submit">Run</button>
  </form>
  <p id="cli-hint" class="muted">Try projects, about, skills, resume, contact, theme mono, or gui. ↑ / ↓ for command history.</p>
  <script type="application/json" id="cli-data" set:html={JSON.stringify({ developer: { ...developer, resume: sitePath(developer.resume) }, skills, projects: entries }).replace(/</g, "\\u003c")} />
</section>
<script>
  import { ALL_THEMES, applyTheme } from "../config/themeConfig";
  const form = document.querySelector<HTMLFormElement>("#cli-form");
  const input = document.querySelector<HTMLInputElement>("#cli-input");
  const output = document.getElementById("cli-output");
  const source = document.getElementById("cli-data")?.textContent;
  interface TerminalData {
    developer: { bio: string; name: string; title: string; email: string; resume: string };
    skills: { category: string; items: string[] }[];
    projects: { title: string; summary: string; href: string }[];
  }
  if (form && input && output && source) {
    const data: TerminalData = JSON.parse(source);
    const history: string[] = [];
    let position = 0;
    const commands = ["help", "about", "projects", "skills", "resume", "contact", "theme", "gui", "clear"];
    function line(text: string, link?: string) {
      const row = document.createElement("p");
      if (link) {
        const a = document.createElement("a");
        a.href = link; a.textContent = text; row.append(a);
      } else row.textContent = text;
      output!.append(row);
    }
    form.addEventListener("submit", event => {
      event.preventDefault();
      const raw = input.value.trim();
      if (!raw) return;
      history.push(raw); position = history.length; input.value = "";
      line("❯ " + raw);
      const [command, argument] = raw.toLowerCase().split(/\s+/);
      switch (command) {
        case "help": line("Commands: " + commands.join(", ")); break;
        case "about": line(data.developer.name + " · " + data.developer.title); line(data.developer.bio); break;
        case "projects": data.projects.forEach(project => { line(project.title + " ↗", project.href); line(project.summary); }); break;
        case "skills": data.skills.forEach(group => line(group.category + ": " + group.items.join(", "))); break;
        case "resume": line("View resume (PDF) ↗", data.developer.resume); break;
        case "contact": line(data.developer.email, "mailto:" + data.developer.email); break;
        case "theme":
          if (!ALL_THEMES.some(theme => theme.id === argument)) { line("Themes: " + ALL_THEMES.map(theme => theme.id).join(", ")); break; }
          applyTheme(argument);
          try { localStorage.setItem("tui_theme", argument); } catch { /* Storage is optional. */ }
          const select = document.querySelector<HTMLSelectElement>("#theme-select");
          if (select) select.value = argument;
          line("Theme: " + argument); break;
        case "gui": document.dispatchEvent(new Event("portfolio:view")); document.getElementById("tab-gui")?.focus(); break;
        case "clear": output.replaceChildren(); break;
        default: line("Unknown command. Type help to see available commands.");
      }
      // Keep the log bounded without inserting user input as HTML.
      while (output.childElementCount > 80) output.firstElementChild?.remove();
      output.scrollTop = output.scrollHeight;
    });
    input.addEventListener("keydown", event => {
      if (event.key === "ArrowUp" || event.key === "ArrowDown") {
        event.preventDefault();
        position = Math.max(0, Math.min(history.length, position + (event.key === "ArrowUp" ? -1 : 1)));
        input.value = history[position] || "";
      }
      if (event.key === "Tab" && input.value) {
        const matches = commands.filter(command => command.startsWith(input.value.toLowerCase()));
        if (matches.length === 1) { event.preventDefault(); input.value = matches[0]; }
      }
    });
  }
</script>
