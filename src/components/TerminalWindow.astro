---
import { ALL_THEMES } from "../config/themeConfig";
import { PORTFOLIO_DATA } from "../data/portfolio";
import { sitePath } from "../utils/paths";
interface Props { home?: boolean; }
const { home = false } = Astro.props;
const { developer } = PORTFOLIO_DATA;
---
<div class="terminal-window">
  <header class="window-header">
    <a class="window-brand" href={sitePath()} aria-label={`${developer.name} home`}>
      <span class="window-lights" aria-hidden="true"><i></i><i></i><i></i></span>
      <span>ben<span class="muted">@</span>engineering<span class="muted">:~</span></span>
    </a>
    <div class="window-controls">
      {home && <div class="mode-tabs" role="group" aria-label="View mode">
        <button id="tab-gui" type="button" aria-pressed="true" aria-controls="view-gui">Portfolio</button>
        <button id="tab-cli" type="button" aria-pressed="false" aria-controls="view-cli" hidden>&gt;_ Terminal</button>
      </div>}
      <label class="theme-label">Theme
        <select id="theme-select" aria-label="Color theme">
          {ALL_THEMES.map(theme => <option value={theme.id} selected={theme.id === "green"}>{theme.name}</option>)}
        </select>
      </label>
    </div>
  </header>
  <nav class="site-nav" aria-label="Main navigation">
    <a href={sitePath("#projects")}>Projects</a>
    <a href={sitePath("#skills")}>Skills</a>
    <a href={sitePath("#leadership")}>Leadership</a>
    <a href={sitePath("#contact")}>Contact</a>
    <a href={sitePath(developer.resume)}>Resume <span aria-hidden="true">↗</span></a>
  </nav>
  <main id="main-content" tabindex="-1"><slot /></main>
  <footer class="window-footer">
    <span>{developer.name} <span class="muted">// Engineering portfolio</span></span>
    <a href={`mailto:${developer.email}`}>{developer.email}</a>
  </footer>
</div>
<script>
  import { applyTheme } from "../config/themeConfig";
  const select = document.querySelector<HTMLSelectElement>("#theme-select");
  if (select) {
    select.value = document.documentElement.dataset.theme || "green";
    select.addEventListener("change", () => {
      applyTheme(select.value);
      try { localStorage.setItem("tui_theme", select.value); } catch { /* Storage is optional. */ }
    });
  }
  const cli = document.getElementById("view-cli");
  const gui = document.getElementById("view-gui");
  const cliTab = document.querySelector<HTMLButtonElement>("#tab-cli");
  const guiTab = document.querySelector<HTMLButtonElement>("#tab-gui");
  if (cli && gui && cliTab && guiTab) {
    cliTab.hidden = false;
    const switchMode = (mode: "cli" | "gui") => {
      cli.hidden = mode !== "cli";
      gui.hidden = mode !== "gui";
      cliTab.setAttribute("aria-pressed", String(mode === "cli"));
      guiTab.setAttribute("aria-pressed", String(mode === "gui"));
      if (mode === "cli") document.getElementById("cli-input")?.focus();
    };
    cliTab.addEventListener("click", () => switchMode("cli"));
    guiTab.addEventListener("click", () => switchMode("gui"));
    document.addEventListener("portfolio:view", () => switchMode("gui"));
    document.querySelectorAll('.site-nav a[href*="#"]').forEach(link => {
      link.addEventListener("click", () => switchMode("gui"));
    });
  }
</script>
