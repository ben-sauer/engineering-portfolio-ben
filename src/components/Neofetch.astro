---
import { PORTFOLIO_DATA } from "../data/portfolio";
const { developer } = PORTFOLIO_DATA;
const palette = ["#0f0f0f", "#ef4444", "#22c55e", "#eab308", "#3b82f6", "#a855f7", "#06b6d4", "#f8fafc"];
---
<div class="profile-summary">
  <dl class="profile-facts">
    <div><dt>Education:</dt><dd>Harvey Mudd College</dd></div>
    <div><dt>Degree:</dt><dd>{developer.education}</dd></div>
    <div><dt>Focus:</dt><dd>Dynamics · Controls · Mechanical design</dd></div>
    <div><dt>Location:</dt><dd>{developer.location}</dd></div>
  </dl>
  <div class="profile-palette"><span>PALETTE:</span><div class="palette-swatches" role="img" aria-label="Eight-color terminal palette">{palette.map(color => <span style={`background-color: ${color}`} />)}</div></div>
</div>
